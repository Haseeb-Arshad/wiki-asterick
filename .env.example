# Copy to .env and adjust. Every value is optional in development.

# Required in production: signs the JWT access tokens. Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In development a secret is generated once and kept in data/.dev-jwt-secret.
JWT_SECRET=

# Production port (hosting platforms usually set this for you).
PORT=3001

# Development API port. The Vite dev server proxies /api here.
API_PORT=3001

# Where the SQLite database lives (default: ./data).
DATA_DIR=./data

# Cookies are marked Secure in production. Set to "false" only if you serve
# production over plain HTTP on a non-localhost address (not recommended).
COOKIE_SECURE=

# Set when running behind a reverse proxy (e.g. "1"), so rate limits see real client IPs.
TRUST_PROXY=

# Wikimedia asks API clients to identify themselves with contact details.
WIKI_USER_AGENT="WikiAsterisk/2.0 (https://your-site.example; you@example.com)"

# --- AI assistant (optional; the reader works without these) ---------------
# OpenRouter key for answers: https://openrouter.ai/keys (set a spend limit there).
OPENROUTER_API_KEY=
# Exa key for live web search, "keep reading" and reading blocked pages: https://exa.ai
EXA_API_KEY=
# Models used for Fast and Deep answers (any OpenRouter model id).
AI_QUICK_MODEL=anthropic/claude-haiku-5.5
AI_DEEP_MODEL=openai/gpt-6-luna
# Sent to OpenRouter as the app's address.
APP_URL=
